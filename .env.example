# Copy this file to .env and adjust values if needed.
# CheapShark API does not require an API key.
GT_API_BASE_URL=https://www.cheapshark.com/api/1.0
GT_DB_PATH=data/game_tracker.db
GT_HTTP_TIMEOUT=10
GT_LOG_LEVEL=WARNING
# Minimal number of hours between two price snapshots of the same game
GT_MIN_SNAPSHOT_INTERVAL_HOURS=6
# Directory for generated price charts
GT_CHARTS_DIR=data/charts
# Exchange rates (Frankfurter / ECB, no API key needed)
GT_FX_API_URL=https://api.frankfurter.dev/v1
# Web interface. Keep 127.0.0.1 so the app is reachable only from this computer.
GT_WEB_HOST=127.0.0.1
GT_WEB_PORT=8000
# Cloud price collection with GitHub Actions (see README, section "Cloud price collection").
# Your repository as owner/name, e.g. titoptitop733-source/Proverca-igor. Leave empty to disable.
GT_SYNC_REPO=
GT_SYNC_BRANCH=data
# Only for PRIVATE repositories: a fine-grained token with read access to contents.
GT_SYNC_TOKEN=
